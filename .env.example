# PPLGCenter — Production Environment Configuration Template
# Copy to .env and fill in values. Never commit .env to version control.
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# Database Connection (Supabase PostgreSQL — obtain from Supabase project dashboard)
DATABASE_URL=

# JWT Secret Configuration (minimum 32 characters)
JWT_SECRET=
JWT_ISSUER=PPLGCenter
JWT_AUDIENCE=PPLGCenterApp
JWT_EXPIRATION_MINUTES=60

# Frontend & CORS Settings (set to the deployed PPLGCenter frontend URL)
NEXT_PUBLIC_API_BASE_URL=https://pplgcenter.onrender.com
CORS__AllowedOrigins=https://pplgcenter.vercel.app

# Initial Admin User Credentials
DEFAULT_ADMIN_PASSWORD=

# Cloudinary Media Gateway Configuration
CLOUDINARY__CLOUDNAME=
CLOUDINARY__APIKEY=
CLOUDINARY__APISECRET=

# Email Notification System (Replyz@pplgcenter.web.id)
EMAIL_FROM=Replyz@pplgcenter.web.id
EMAIL_FROM_NAME="Replyz"
EMAIL_MODE=development

# Provider 1: Resend (Recommended for custom domain)
RESEND_API_KEY=

# Provider 2: Custom SMTP (Fallback / Alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_SSL=true
