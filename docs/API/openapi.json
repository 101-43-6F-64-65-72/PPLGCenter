{
  "openapi": "3.0.1",
  "info": {
    "title": "Student Center API",
    "version": "v1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "responses": {
          "200": { "description": "System Healthy" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "User authentication",
        "responses": {
          "200": { "description": "Login Successful" },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  }
}
