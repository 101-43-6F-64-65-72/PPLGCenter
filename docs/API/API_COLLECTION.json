{
  "info": {
    "name": "StudentCenter API v1.0.0",
    "description": "REST API collection for StudentCenter — SMK Negeri 2 Surakarta",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5051", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@studentcenter.id\",\n  \"password\": \"admin1234\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Announcements",
      "item": [
        {
          "name": "List Announcements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/announcements?page=1&pageSize=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Announcement",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/announcements",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Pengumuman Test\",\n  \"content\": \"Isi pengumuman\",\n  \"category\": \"Semua\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Facilities",
      "item": [
        {
          "name": "List Facilities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/facilities",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Proposals",
      "item": [
        {
          "name": "List Proposals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/proposals",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Submit Proposal",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/proposals",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Proposal Kegiatan\",\n  \"description\": \"Deskripsi kegiatan\",\n  \"documentUrl\": \"https://drive.google.com/proposal.pdf\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Readiness Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/ready" }
        },
        {
          "name": "Liveness Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/live" }
        }
      ]
    }
  ]
}
