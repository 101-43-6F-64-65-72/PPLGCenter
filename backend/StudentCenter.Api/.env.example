# StudentCenter API - required environment variables.
# Copy to .env (git-ignored) or export in your deployment environment.
# Never commit real values.

# PostgreSQL / Supabase connection string (Npgsql key=value format).
# IMPORTANT: Npgsql (used by EF Core here) does NOT accept libpq URI strings
# such as "postgres://user:password@host:5432/db" or "postgresql://...".
# If your provider (e.g. Supabase) gives you a URI, convert it like this:
#   postgres://user:pass@host:5432/db   ->
#   Host=host;Port=5432;Database=db;Username=user;Password=pass
DATABASE_URL=Host=db.ryskvrqcrytmdsorviie.supabase.co;Port=5432;Database=postgres;Username=postgres.ryskvrqcrytmdsorviie;Password=YOUR_SUPABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
# JWT signing key. MUST be at least 32 bytes (256 bits). Use a long random string.
JWT_SECRET=akjhgfdrtyjnmnbytghytfvbnjykbrcr

# Optional JWT overrides (defaults: StudentCenter / StudentCenterApp / 60 minutes).
JWT_ISSUER=StudentCenter
JWT_AUDIENCE=StudentCenterApp
JWT_EXPIRATION_MINUTES=60

# CORS allowed origins for production (comma or semicolon separated). Never "*".
# In development only http://localhost:3000 is allowed.
CORS__AllowedOrigins=http://localhost:3000

# Password used to seed the initial Admin user when no admin exists yet.
# Must be set on first startup.
DEFAULT_ADMIN_PASSWORD=admin1234

# opencode CLI configuration (root of repo, opencode.jsonc).
OPENCODE_API_KEY=sk-1838980bfd7a3387-kzt9f1-97edcefb
