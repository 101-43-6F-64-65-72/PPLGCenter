# ASP.NET Core Backend Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment PaaS / Docker / VPS.

# Kestrel Web Host Listening Port (Default: 5051)
PORT=5051

# PostgreSQL Database Connection String (PostgreSQL / Supabase)
DATABASE_URL="Host=localhost;Port=5432;Database=studentcenter;Username=postgres;Password=postgres;SSL Mode=Prefer"

# JWT Authentication Signing Key (Minimum 32 characters / 256 bits for HMAC-SHA256)
JWT_SECRET="StudentCenter2026SuperSecretKeyForJwtAuthenticationMustBe32Bytes!!"

# Optional: Path to Docker Secret File containing JWT Secret (Overrides JWT_SECRET if present)
# JWT_SECRET__FILE="/run/secrets/jwt_secret"

# JWT Token Issuer and Audience
JWT_ISSUER="StudentCenter"
JWT_AUDIENCE="StudentCenterApp"

# CORS Allowed Origins (Comma-separated list of permitted frontend origins)
CORS__AllowedOrigins="http://localhost:3000,http://127.0.0.1:3000"

# File Upload Physical Storage Directory (Relative or Rooted Path)
UPLOAD_PATH="wwwroot/uploads"
