# PPLGCenter — ASP.NET Core Backend Environment Configuration Template
# Copy to .env or set as environment variables in your deployment environment.

# Kestrel Web Host Listening Port (Default: 5051)
PORT=5051

# PostgreSQL Database Connection String
DATABASE_URL=

# JWT Authentication Signing Key (minimum 32 characters / 256 bits for HMAC-SHA256)
JWT_SECRET=

# Optional: Path to Docker Secret File containing JWT Secret (overrides JWT_SECRET if present)
# JWT_SECRET__FILE=/run/secrets/jwt_secret

# JWT Token Issuer and Audience
JWT_ISSUER=PPLGCenter
JWT_AUDIENCE=PPLGCenterApp

# CORS Allowed Origins (comma-separated list of permitted frontend origins)
CORS__AllowedOrigins=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary configuration (obtain from Cloudinary PPLGCenter account)
CLOUDINARY__CLOUDNAME=
CLOUDINARY__APIKEY=
CLOUDINARY__APISECRET=

# File Upload Physical Storage Directory (relative or rooted path)
UPLOAD_PATH=wwwroot/uploads

# Email Notification System (Replyz@pplgcenter.web.id)
EMAIL_FROM=Replyz@pplgcenter.web.id
EMAIL_FROM_NAME="Replyz"
EMAIL_MODE=development

# Provider 1: Resend (Recommended for custom domain)
RESEND_API_KEY=

# Provider 2: Custom SMTP (Fallback / Alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_SSL=true
